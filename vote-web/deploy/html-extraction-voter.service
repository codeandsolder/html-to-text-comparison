[Unit]
Description=HTML-to-text comparison voting arena
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=jan
Group=jan
WorkingDirectory=/home/jan/services/html-extraction-voter
ExecStart=/home/jan/services/html-extraction-voter/html-extraction-voter
Environment=VOTER_DATASET=/home/jan/datasets/html-to-text-comparison/js-redox-random100-20261115
Environment=VOTER_DATABASE=/home/jan/datasets/html-to-text-comparison/js-redox-random100-20261115/voting/votes.sqlite
Environment=VOTER_BIND=127.0.0.1:18578
Environment=RUST_LOG=html_extraction_voter=info,tower_http=warn
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/home/jan/datasets/html-to-text-comparison/js-redox-random100-20261115/voting
MemoryMax=512M
TasksMax=96

[Install]
WantedBy=multi-user.target
