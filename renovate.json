{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "E2M integration is release-tier and must not merge without an explicit heavy test",
      "matchManagers": ["pip_requirements"],
      "matchPackageNames": ["wisup-e2m"],
      "automerge": false
    },
    {
      "description": "JS extraction engine and DOM dependencies must pass real content comparisons",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@mozilla/readability", "linkedom", "defuddle"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track uv bootstrap wheel pinned in CI",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["uv==(?<currentValue>[0-9][0-9.]+)"],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Track pinned jsdiff browser CDN version",
      "managerFilePatterns": ["/^src/web_ui\\.html$/"],
      "matchStrings": ["cdn\\.jsdelivr\\.net/npm/diff@(?<currentValue>[0-9][0-9.]+)/dist/diff\\.min\\.js"],
      "depNameTemplate": "diff",
      "datasourceTemplate": "npm"
    }
  ]
}
